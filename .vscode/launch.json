        "run.config": "{\"handlerId\":\"cap_run_config_handler_id\",\"runnableId\":\"{\\\"projectPath\\\":\\\"/home/user/projects/employee_leave_management\\\",\\\"profileName\\\":\\\"hybrid\\\"}\"}"
      }
